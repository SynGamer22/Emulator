<Window x:Class="KubicEmu.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KubicEmu Setup" Height="510" Width="720" MinHeight="510" MinWidth="720"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}" Foreground="#F3F4F8" FontFamily="Segoe UI">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="KubicEmu" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="WINDOWS INSTALLER" FontSize="10" Foreground="#969BAD" Margin="1,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="InstallKind" Text="New installation" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#BFC3D0"/>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Application package" Foreground="#BFC3D0" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowsePackage_Click"/>
                    <TextBox x:Name="PackagePath" TextChanged="PackagePath_Changed" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="PackageSize" Text="Package size: not selected" Foreground="#969BAD" Margin="1,7,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Install location" Foreground="#BFC3D0" Margin="0,0,0,8"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Choose folder..." Click="BrowseFolder_Click"/>
                    <TextBox x:Name="InstallFolder" TextChanged="InstallFolder_Changed" VerticalContentAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#11131A" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="InstallStatus" Text="Choose an application package and install location." Foreground="#C8CBD5" TextWrapping="Wrap"/>
                <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Margin="0,12,0,7" Background="#303342" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="ProgressDetail" Text="Ready" Foreground="#969BAD" FontSize="11"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="Android data and virtual disks are stored separately and will not be removed by updates." Foreground="#969BAD" TextWrapping="Wrap" Margin="1,0,0,14"/>
        <Grid Grid.Row="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="InstallButton" Content="Install" Click="Install_Click" Background="{StaticResource Accent}" MinWidth="116"/>
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
            </StackPanel>
            <Button x:Name="LaunchButton" Content="Launch KubicEmu" Click="Launch_Click" HorizontalAlignment="Right" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>